// Cleana+ data model — see docs/product-spec.md section 6 for the full spec.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum ProfessionType {
  coach
  massage
  trainer
  therapist
  tutor
  other
}

enum TherapistStatus {
  active
  suspended
  deleted
}

enum SubscriptionTier {
  // No paid plan: the trial, and whatever the trial becomes when it is not paid for.
  free
  // The one paid plan. Every feature, one price (see PLAN_PRICE_ILS).
  plus
  // Kept only so existing rows stay readable; nothing writes these any more.
  basic
  pro
  business
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  unpaid
}

enum BillingCycle {
  monthly
  yearly
}

enum LocationType {
  clinic
  online
  client_home
  hybrid
}

enum SessionStatus {
  open
  held
  booked
  blocked
  completed
  canceled
}

enum BookingStatus {
  pending
  confirmed
  canceled_by_client
  canceled_by_therapist
  completed
  no_show
}

enum NotificationType {
  // About one booking.
  confirmation
  reminder
  cancellation
  reschedule
  // About the therapist's own account, with no booking behind them.
  welcome
  onboarding_complete
  subscription
  trial_reminder
}

enum NotificationChannel {
  email
  sms
  whatsapp
}

enum NotificationStatus {
  pending
  sent
  failed
  canceled
}

enum IntegrationProvider {
  whatsapp
  zoom
  calendar
  // Kept only so existing rows stay readable. Payments was withdrawn from the
  // product; Postgres cannot drop a value from an enum in place, and recreating
  // the type is not worth the risk for a value nothing writes any more. The
  // app-level catalogue in src/lib/integration-providers.ts is the source of
  // truth for which add-ons exist.
  payments
}

// Only what a therapist actually did. "Unavailable" (the server has no API
// credentials for this provider yet) is derived from the environment at read
// time in src/lib/integrations.ts — persisting it would go stale the moment a
// key is added or removed.
enum IntegrationStatus {
  disconnected
  connected
}

enum AuditActorType {
  therapist
  client
  system
  admin
}

// ---------- Models ----------

model Therapist {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String          @unique @db.VarChar(255)
  fullName            String          @map("full_name") @db.VarChar(255)
  phone               String?         @db.VarChar(50)
  slug                String          @unique @db.VarChar(40)
  // Null until the therapist changes their slug from the assigned fallback — enforces
  // spec 5.5's "not more than once per 30 days" cooldown.
  slugChangedAt       DateTime?       @map("slug_changed_at") @db.Timestamptz
  // Nullable: unknown until onboarding wizard step 1 (spec 7.1); required before onboarding_completed=true.
  professionType      ProfessionType? @map("profession_type")
  clerkUserId         String?         @unique @map("clerk_user_id") @db.VarChar(255)
  timezone            String          @default("Asia/Jerusalem") @db.VarChar(100)
  // "en" | "he" — governs the dashboard, the public booking page and every
  // message to clients. English by default: the group site and the landing page
  // are English, and the product is meant to read the same way out of the box.
  locale              String          @default("en") @db.VarChar(10)
  status              TherapistStatus @default(active)
  onboardingCompleted Boolean         @default(false) @map("onboarding_completed")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  subscription      Subscription?
  settings          TherapistSettings?
  availabilityRules AvailabilityRule[]
  sessions          Session[]
  clients           Client[]
  bookings          Booking[]
  auditLogs         AuditLog[]
  slugRedirects     SlugRedirect[]
  integrations      Integration[]
  payments          Payment[]
  notifications     Notification[]

  @@map("therapists")
}

// spec 11.3: an old slug keeps resolving (via redirect) for 90 days after a therapist changes it.
model SlugRedirect {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oldSlug     String   @unique @map("old_slug") @db.VarChar(40)
  therapistId String   @map("therapist_id") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  therapist Therapist @relation(fields: [therapistId], references: [id])

  @@index([therapistId])
  @@map("slug_redirects")
}

model Subscription {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  therapistId           String             @unique @map("therapist_id") @db.Uuid
  tier                  SubscriptionTier   @default(free)
  // A brand-new signup has no card and no trial — Free is just permanently active (spec 7.5).
  status                SubscriptionStatus @default(active)
  // PayPlus's handle on the recurring charge — what a cancellation is sent to.
  payplusRecurringUid   String?            @unique @map("payplus_recurring_uid") @db.VarChar(255)
  payplusCustomerUid    String?            @map("payplus_customer_uid") @db.VarChar(255)
  payplusTokenUid       String?            @map("payplus_token_uid") @db.VarChar(255)
  // The checkout link most recently handed to this therapist. Lets the callback
  // find the account even when more_info did not round-trip.
  pendingPageRequestUid String?            @map("pending_page_request_uid") @db.VarChar(255)
  // After the trial (or a failed renewal) the dashboard stays open until this
  // moment, then locks. Stored, not derived, so the grace length can change
  // without moving anybody's deadline retroactively.
  graceEndsAt           DateTime?          @map("grace_ends_at") @db.Timestamptz
  // Which trial countdown mail went out last (23, 28 or 30), so each is sent once.
  lastTrialReminderDay  Int?               @map("last_trial_reminder_day")
  billingCycle          BillingCycle       @default(monthly) @map("billing_cycle")
  currentPeriodStart    DateTime?          @map("current_period_start") @db.Timestamptz
  currentPeriodEnd      DateTime?          @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd     Boolean            @default(false) @map("cancel_at_period_end")
  trialEndsAt           DateTime?          @map("trial_ends_at") @db.Timestamptz
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  therapist Therapist @relation(fields: [therapistId], references: [id])

  @@map("subscriptions")
}

enum PaymentStatus {
  succeeded
  failed
  refunded
}

// One row per charge PayPlus reported and we verified — the therapist's receipt
// history and the audit trail behind every change to their subscription.
model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  therapistId    String        @map("therapist_id") @db.Uuid
  provider       String        @default("payplus") @db.VarChar(20)
  // PayPlus's transaction id. Unique so a redelivered callback is a no-op.
  transactionUid String        @unique @map("transaction_uid") @db.VarChar(255)
  pageRequestUid String?       @map("page_request_uid") @db.VarChar(255)
  recurringUid   String?       @map("recurring_uid") @db.VarChar(255)
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("ILS") @db.VarChar(3)
  status         PaymentStatus
  // PayPlus's own code ("000" is success) for support conversations.
  statusCode     String?       @map("status_code") @db.VarChar(10)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz
  // The subscription period this charge paid for.
  periodStart    DateTime?     @map("period_start") @db.Timestamptz
  periodEnd      DateTime?     @map("period_end") @db.Timestamptz
  // The verified transaction as PayPlus returned it, for audits.
  raw            Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  therapist Therapist @relation(fields: [therapistId], references: [id])

  @@index([therapistId, createdAt])
  @@map("payments")
}

model TherapistSettings {
  therapistId             String       @id @map("therapist_id") @db.Uuid
  defaultDurationMinutes  Int          @default(50) @map("default_duration_minutes")
  bufferBeforeMinutes     Int          @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes      Int          @default(0) @map("buffer_after_minutes")
  minNoticeHours          Int          @default(12) @map("min_notice_hours")
  maxAdvanceDays          Int          @default(60) @map("max_advance_days")
  locationType            LocationType @default(clinic) @map("location_type")
  locationAddress         String?      @map("location_address")
  locationNotes           String?      @map("location_notes")
  onlineMeetingUrl        String?      @map("online_meeting_url")
  cancellationPolicyHours Int          @default(24) @map("cancellation_policy_hours")
  cancellationPolicyText  String?      @map("cancellation_policy_text")
  requirePhone            Boolean      @default(true) @map("require_phone")
  autoConfirm             Boolean      @default(true) @map("auto_confirm")
  sendEmailConfirmation   Boolean      @default(true) @map("send_email_confirmation")
  sendEmailReminder       Boolean      @default(false) @map("send_email_reminder")
  // Named for SMS, which was never implemented. It is the "message the client a
  // reminder" switch, and WhatsApp is what it now drives — see scheduleReminders
  // in src/lib/notifications.ts. Renaming the column would break every existing row.
  sendSmsReminder         Boolean      @default(false) @map("send_sms_reminder")
  reminderHoursBefore     Int          @default(24) @map("reminder_hours_before")
  brandColor              String?      @map("brand_color") @db.VarChar(7)
  brandLogoUrl            String?      @map("brand_logo_url")
  bookingPageHeadline     String?      @map("booking_page_headline") @db.VarChar(255)
  bookingPageDescription  String?      @map("booking_page_description")

  therapist Therapist @relation(fields: [therapistId], references: [id])

  @@map("therapist_settings")
}

model AvailabilityRule {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  therapistId         String    @map("therapist_id") @db.Uuid
  dayOfWeek           Int       @map("day_of_week")
  startTime           DateTime  @map("start_time") @db.Time
  endTime             DateTime  @map("end_time") @db.Time
  slotDurationMinutes Int       @map("slot_duration_minutes")
  isActive            Boolean   @default(true) @map("is_active")
  validFrom           DateTime? @map("valid_from") @db.Date
  validUntil          DateTime? @map("valid_until") @db.Date

  therapist Therapist @relation(fields: [therapistId], references: [id])
  sessions  Session[]

  @@index([therapistId])
  @@map("availability_rules")
}

model Session {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  therapistId         String        @map("therapist_id") @db.Uuid
  startsAt            DateTime      @map("starts_at") @db.Timestamptz
  endsAt              DateTime      @map("ends_at") @db.Timestamptz
  status              SessionStatus @default(open)
  blockedNote         String?       @map("blocked_note") @db.VarChar(80)
  generatedFromRuleId String?       @map("generated_from_rule_id") @db.Uuid
  holdExpiresAt       DateTime?     @map("hold_expires_at") @db.Timestamptz
  version             Int           @default(0)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  therapist         Therapist         @relation(fields: [therapistId], references: [id])
  generatedFromRule AvailabilityRule? @relation(fields: [generatedFromRuleId], references: [id])
  booking           Booking?

  @@index([therapistId, startsAt])
  @@index([therapistId, status, startsAt])
  @@map("sessions")
}

model Client {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  therapistId   String   @map("therapist_id") @db.Uuid
  fullName      String   @map("full_name") @db.VarChar(255)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  notes         String?  @db.VarChar(200)
  totalBookings Int      @default(0) @map("total_bookings")
  noShowCount   Int      @default(0) @map("no_show_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  therapist Therapist @relation(fields: [therapistId], references: [id])
  bookings  Booking[]

  @@unique([therapistId, email])
  @@map("clients")
}

model Booking {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  therapistId         String        @map("therapist_id") @db.Uuid
  sessionId           String        @unique @map("session_id") @db.Uuid
  clientId            String        @map("client_id") @db.Uuid
  clientNameSnapshot  String        @map("client_name_snapshot") @db.VarChar(255)
  clientEmailSnapshot String?       @map("client_email_snapshot") @db.VarChar(255)
  clientPhoneSnapshot String?       @map("client_phone_snapshot") @db.VarChar(50)
  status              BookingStatus @default(pending)
  clientNote          String?       @map("client_note") @db.VarChar(200)
  // Join URL of the video meeting opened for this booking, when the therapist has
  // the Zoom add-on connected. Per booking rather than per therapist: a single
  // reusable room lets one client walk into another's session.
  meetingUrl          String?       @map("meeting_url")
  manageToken         String        @unique @map("manage_token") @db.VarChar(64)
  canceledAt          DateTime?     @map("canceled_at") @db.Timestamptz
  cancellationReason  String?       @map("cancellation_reason")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz

  therapist     Therapist      @relation(fields: [therapistId], references: [id])
  session       Session        @relation(fields: [sessionId], references: [id])
  client        Client         @relation(fields: [clientId], references: [id])
  notifications Notification[]

  @@index([therapistId, status])
  @@map("bookings")
}

// Every message the system sends, on any channel, with what happened to it.
// One log for booking mail and account mail alike, so a failed send is a row
// somebody can find rather than a line in a log nobody reads.
model Notification {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Always known — account mail has no booking, but it always has a therapist.
  therapistId  String              @map("therapist_id") @db.Uuid
  // Null for account mail: a welcome or a subscription notice is about the
  // therapist, not about an appointment.
  bookingId    String?             @map("booking_id") @db.Uuid
  type         NotificationType
  channel      NotificationChannel
  recipient    String              @db.VarChar(255)
  scheduledFor DateTime?           @map("scheduled_for") @db.Timestamptz
  sentAt       DateTime?           @map("sent_at") @db.Timestamptz
  status       NotificationStatus  @default(pending)
  attempts     Int                 @default(0)
  errorMessage String?             @map("error_message")

  therapist Therapist @relation(fields: [therapistId], references: [id])
  booking   Booking?  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([therapistId, status])
  @@index([status, scheduledFor])
  @@map("notifications")
}

// One row per add-on a therapist has switched on. Absent row == never touched,
// which reads as "disconnected" — the catalogue in src/lib/integrations.ts is the
// source of truth for which providers exist, not this table.
model Integration {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  therapistId    String              @map("therapist_id") @db.Uuid
  provider       IntegrationProvider
  status         IntegrationStatus   @default(disconnected)
  // The therapist's own credentials for this provider, AES-256-GCM encrypted as a
  // single JSON blob (src/lib/secret-box.ts). Never returned to the browser and
  // never logged — the UI only ever learns which fields are already filled in.
  credentials    String?             @db.Text
  // Non-secret label the provider echoed back when we verified those credentials
  // (the Zoom account email, the Stripe business name), so the therapist can see
  // which account is linked without us showing the secret.
  accountLabel   String?             @map("account_label") @db.VarChar(255)
  // When the credentials last actually worked against the provider's API, and why
  // they stopped if they did. A key the therapist revoked surfaces here instead of
  // as a silent failure at the moment a client books.
  lastVerifiedAt DateTime?           @map("last_verified_at") @db.Timestamptz
  lastError      String?             @map("last_error")
  // Capability token embedded in the calendar subscription URL. Unique so the feed
  // route can look a therapist up by it, and nullable because only the calendar
  // add-on issues one.
  feedToken      String?             @unique @map("feed_token") @db.VarChar(64)
  connectedAt    DateTime?           @map("connected_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  therapist Therapist @relation(fields: [therapistId], references: [id])

  @@unique([therapistId, provider])
  @@map("integrations")
}

// Fixed-window request counter for the public, unauthenticated endpoints.
//
// Postgres rather than a KV store: this app already depends on it, and adding a
// second service to hold four-minute-old integers is not worth an account, a
// key and another thing that can be down. A window is baked into the key, so a
// hit is one upsert and expiry is a delete of anything older.
model RateLimit {
  // "<scope>:<identifier>:<window index>"
  key         String   @id @db.VarChar(200)
  windowStart DateTime @map("window_start") @db.Timestamptz
  count       Int      @default(0)

  @@index([windowStart])
  @@map("rate_limits")
}

model AuditLog {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  therapistId String         @map("therapist_id") @db.Uuid
  actorType   AuditActorType @map("actor_type")
  action      String         @db.VarChar(255)
  entityType  String?        @map("entity_type") @db.VarChar(100)
  entityId    String?        @map("entity_id") @db.Uuid
  metadata    Json?          @db.JsonB
  ipAddress   String?        @map("ip_address") @db.Inet
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  therapist Therapist @relation(fields: [therapistId], references: [id])

  @@index([therapistId, createdAt])
  @@map("audit_logs")
}
