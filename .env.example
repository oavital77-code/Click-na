DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cleana_dev?schema=public"

# Clerk (https://dashboard.clerk.com) — Configure & API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Clerk (https://dashboard.clerk.com) — Webhooks > add endpoint /api/webhooks/clerk, subscribe to user.created / user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=""

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Resend (https://resend.com) — used for confirmation/reminder/cancellation emails
RESEND_API_KEY=""
EMAIL_FROM="Cleana+ <notifications@cleana.co.il>"

# Public URL of the deployed app — used to build links inside emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` when
# calling /api/cron/send-reminders. Leave empty locally to call the route unauthenticated.
CRON_SECRET=""
