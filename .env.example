DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cleana_dev?schema=public"

# Production only (e.g. Supabase): DATABASE_URL should point at the connection
# *pooler* (transaction mode, port 6543, `pgbouncer=true`) for app runtime queries.
# DIRECT_URL is a separate, non-pooled connection (port 5432) used only for
# `prisma migrate` — pgbouncer's transaction mode can't run migrations. Leave
# DIRECT_URL unset for local dev against a plain local Postgres.
# DIRECT_URL=""

# Clerk (https://dashboard.clerk.com) — Configure & API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Clerk (https://dashboard.clerk.com) — Webhooks > add endpoint /api/webhooks/clerk, subscribe to user.created / user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=""

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Resend (https://resend.com) — used for confirmation/reminder/cancellation emails.
# EMAIL_FROM has no default on purpose: it must be an address on a domain verified
# in THIS project's Resend account. Sending is refused while it is unset, so the app
# can never fall back to a domain belonging to an unrelated project.
RESEND_API_KEY=""
EMAIL_FROM=""

# Public URL of the deployed app — used both for the links inside emails and for the
# booking-link prefix shown in the UI. MUST be the real deployed origin in production,
# or every emailed link points at localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` when
# calling /api/cron/send-reminders. Leave empty locally to call the route unauthenticated.
CRON_SECRET=""

# 32 random bytes, base64. Encrypts the third-party credentials a therapist enters
# on the add-ons tab (their own Stripe key, Twilio token, Zoom secret) before they
# are written to the database. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it the add-ons that need an account refuse to save; calendar sync still works.
# Changing it makes every stored credential unreadable, and each therapist has to
# re-enter theirs.
INTEGRATION_ENCRYPTION_KEY=""

# Optional. An internal address that gets a short alert whenever a new therapist
# signs up. Left empty, no alert is sent — the signup itself is unaffected.
OWNER_NOTIFICATION_EMAIL=""
